# Supabase connection (public reads + admin writes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin server-side privileged access (strictly server-only)
# Used only when cookie-based auth does not map to Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (fails closed if absent)
ADMIN_PASSWORD=your-secure-password
